{
  "expo": {
    "name": "Parvsetu",
    "slug": "parvsetu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.parvsetu.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.parvsetu.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Parvsetu uses the camera to scan entry passes at the festival gate.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "parvsetu",
    "extra": {
      "apiUrl": "https://parvsetu-api.onrender.com/api/v1",
      "webUrl": "https://parvsetu-web.vercel.app"
    }
  }
}
