// Parvsetu — festival/mandal management.
//
// Tenancy: Organization (mandal) → Event (festival edition). Every operational
// record (token, scan, donation, expense, time slot) carries eventId; access is
// always resolved server-side through AccessService (org membership role ∪
// event assignment role). See docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

// EXPIRED is never stored: it is derived (status ACTIVE and validUntil <= now),
// so an admin extending a window never has to "un-expire" a row.
enum TokenStatus {
  ACTIVE
  USED
  CANCELLED
}

enum ScanResult {
  SUCCESS
  ALREADY_USED
  EXPIRED
  NOT_YET_VALID
  CANCELLED
  INVALID
  WRONG_EVENT
  UNAUTHORIZED
}

enum PassOrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  /// Stall bookings only: a paid booking the mandal cancelled (refund in refundPaise).
  CANCELLED
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum SponsorTier {
  TITLE
  PLATINUM
  GOLD
  SILVER
  PARTNER
}

enum CreditTxType {
  RECHARGE
  TOKEN_FEE
  REFUND
  ADJUSTMENT
  WELCOME
}

enum PayoutEntityType {
  REGISTERED
  UNREGISTERED
}

enum PayoutAccountStatus {
  PENDING
  VERIFIED
  NEEDS_CORRECTION
  REJECTED
}

enum SettlementStatus {
  PENDING_PAYOUT
  PAID_OUT
}

enum ScanMethod {
  QR
  MANUAL
}

enum DonationMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum PartnerCampaignStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAUSED
  ENDED
  CANCELLED
}

enum PartnerTxType {
  RECHARGE
  PASS_PRINT
  REFUND
  ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id                        String     @id @default(uuid())
  name                      String
  mobile                    String     @unique
  email                     String?    @unique
  passwordHash              String
  isSuperAdmin              Boolean    @default(false)
  status                    UserStatus @default(ACTIVE)
  // Bumped on password change / disable — invalidates outstanding JWTs.
  tokenVersion              Int        @default(0)
  emailVerifiedAt           DateTime?
  // Self-registered accounts must verify their email before they can log in.
  requiresEmailVerification Boolean    @default(false)
  /// Set for promotional-partner (brand) accounts; such a user belongs to no Organization.
  partnerId                 String?
  /// Set for field-agent accounts; such a user belongs to no Organization.
  agentId                   String?
  /// Set for stall-vendor accounts; such a user belongs to no Organization.
  vendorId                  String?
  /// Set for blogger / influencer accounts; such a user belongs to no Organization.
  bloggerId                 String?
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  memberships         OrganizationMember[]
  assignments         EventAssignment[]      @relation("AssignmentUser")
  applications        VolunteerApplication[] @relation("ApplicationUser")
  scanLogs            ScanLog[]
  tokensUsed          Token[]                @relation("TokenUsedBy")
  tokensIssued        Token[]                @relation("TokenIssuedBy")
  tokensCancelled     Token[]                @relation("TokenCancelledBy")
  donationsCreated    Donation[]
  expensesCreated     Expense[]
  auditLogs           AuditLog[]
  otps                EmailOtp[]
  partner             Partner?               @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  agent               Agent?                 @relation(fields: [agentId], references: [id], onDelete: SetNull)
  vendor              Vendor?                @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  blogger             Blogger?               @relation(fields: [bloggerId], references: [id], onDelete: SetNull)
  stallBookings       StallBooking[]         @relation("StallBookingCreatedBy")
  mandalRegistrations MandalRegistration[]   @relation("RegistrationApplicant")
  passwordSetupTokens PasswordSetupToken[]
  pushSubscriptions   PushSubscription[]

  @@index([partnerId])
  @@index([agentId])
  @@index([vendorId])
  @@index([bloggerId])
  @@map("users")
}

model Organization {
  id                String    @id @default(uuid())
  name              String
  slug              String    @unique
  state             String?
  city              String?
  address           String?
  /// Festival/event types this mandal celebrates; the event form lists only these. Empty = show all.
  festivalTypes     String[]  @default([])
  /// ImageStore keys (bytes live behind the ImageStore interface, never on this row).
  logoKey           String?
  logoUpdatedAt     DateTime?
  bannerKey         String?
  bannerUpdatedAt   DateTime?
  /// Field agent who brought this mandal in (referral earnings). Set from the registration or by the super admin.
  agentId           String?
  agentAttributedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  members            OrganizationMember[]
  events             Event[]
  roles              Role[]
  applications       VolunteerApplication[]
  auditLogs          AuditLog[]
  expenses           Expense[]
  sponsors           Sponsor[]
  billing            OrgBilling?
  instagram          InstagramConnection?
  instagramMedia     InstagramMedia[]
  taxProfile         OrgTaxProfile?
  payoutAccount      PayoutAccount?
  settlements        PaymentSettlement[]
  payouts            Payout[]
  creditTransactions CreditTransaction[]
  creditRecharges    CreditRecharge[]
  partnerCampaigns   PartnerCampaign[]
  photos             EventPhoto[]
  storedImages       StoredImage[]
  landingPage        LandingPage?
  landingPurchases   LandingPurchase[]
  reviews            VisitorReview[]
  reviewPhotos       ReviewPhoto[]
  achievements       Achievement[]
  stallTypes         StallType[]
  stallBookings      StallBooking[]
  agent              Agent?                 @relation(fields: [agentId], references: [id], onDelete: SetNull)
  registration       MandalRegistration?
  eventFeePayments   EventFeePayment[]
  agentLedger        AgentLedgerEntry[]

  @@index([agentId])
  @@map("organizations")
}

// Permission catalog is code (src/common/permissions.ts) mirrored into this
// table by the seed, so RolePermission rows have a real FK target.
model Permission {
  key         String           @id
  group       String
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id             String   @id @default(uuid())
  // null = system role (template usable by every organization, immutable via API)
  organizationId String?
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  OrganizationMember[]
  assignments  EventAssignment[]

  @@unique([organizationId, key])
  @@map("roles")
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

// Org-wide role: applies to every event of the organization (Mandal Admin,
// Report Viewer, Treasurer...).
model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Event {
  id                        String              @id @default(uuid())
  organizationId            String
  name                      String
  /// Public page address /f/<slug> (lowercase, must contain the festival year — see common/event-slug.ts).
  /// Null only for events created before slugs; the seed backfills them.
  slug                      String?             @unique
  // Free-form key so new festivals need no migration (GANESH_UTSAV, DURGA_PUJA, ...).
  festivalType              String
  description               String?
  location                  String?
  state                     String?
  city                      String?
  venueAddress              String?
  venueLandmark             String?
  venuePincode              String?
  venueMapUrl               String?
  venueLat                  Float?
  venueLng                  Float?
  venueNotes                String?
  venueContactPhone         String?
  startDate                 DateTime            @db.Date
  endDate                   DateTime            @db.Date
  timezone                  String              @default("Asia/Kolkata")
  status                    EventStatus         @default(DRAFT)
  tokenPrefix               String
  // Atomic per-event counter for human-readable token codes (PREFIX-YYYY-000001).
  tokenSeq                  Int                 @default(0)
  donationReceiptSeq        Int                 @default(0)
  volunteerRegistrationOpen Boolean             @default(false)
  // Visitors can buy/book passes on the public site (prices live on time slots).
  publicBookingEnabled      Boolean             @default(false)
  // Visitors can donate online from the public festival page (/donate/<event>).
  publicDonationsEnabled    Boolean             @default(false)
  /// Online pass sales window (null = open as soon as the festival is live / until each slot ends).
  /// Lets a mandal announce "passes on sale from 1 Oct, 10 am" for a festival that starts later.
  bookingOpensAt            DateTime?
  bookingClosesAt           DateTime?
  // Duration presets (hours) the token desk may issue, e.g. {3,4,6,24}.
  // Admins (TOKEN_GENERATE) may use any duration.
  tokenDurationOptions      Int[]               @default([])
  // GST on online pass sales. Bearer CUSTOMER = added on top of the price;
  // MANDAL = price is GST-inclusive (tax carved out of it).
  gstEnabled                Boolean             @default(false)
  gstRateBps                Int                 @default(1800)
  gstBearer                 String              @default("CUSTOMER")
  gstSac                    String              @default("9996")
  /// SLAB: per-ticket taxable value ≤ threshold → gstLowRateBps, above → gstRateBps.
  /// FLAT: gstRateBps for every ticket.
  gstMode                   String              @default("SLAB")
  gstSlabThresholdPaise     Int                 @default(10000)
  gstLowRateBps             Int                 @default(500)
  passInvoiceSeq            Int                 @default(0)
  /// Stall booking (vendors book stalls online). Invoice numbers use their own counter.
  stallBookingEnabled       Boolean             @default(false)
  stallCreditNoteSeq        Int                 @default(0)
  stallInvoiceSeq           Int                 @default(0)
  /// Tax-invoice / credit-note counters for competition entry fees.
  competitionInvoiceSeq     Int                 @default(0)
  competitionCreditNoteSeq  Int                 @default(0)
  /// GST on stall rent when the festival has GST on (added on top; CA review — see stalls.rules.ts).
  stallGstRateBps           Int                 @default(1800)
  /// Default print layout for passes: A4 | THERMAL_80 | THERMAL_58
  passPrintFormat           String              @default("A4")
  maxVisitorsPerToken       Int                 @default(10)
  /// Organiser's own instructions printed on every visitor pass (one per line), after the standard ones.
  passInstructions          String?
  /// Platform review/payment state (see common/event-approval.ts). Only LIVE events are public,
  /// bookable, can issue/scan passes or be set ACTIVE. Event.status stays the operational state.
  approvalStatus            EventApprovalStatus @default(DRAFT)
  /// Events that existed before per-event fees (treated as paid, fee 0).
  feeLegacy                 Boolean             @default(false)
  /// Fee quoted when submitted for review; locked into feePaise when the super admin approves.
  feeQuotedPaise            Int?
  feePaise                  Int?
  /// Where the quote came from: MANDAL | FESTIVAL_TYPE | GROUP | DEFAULT
  feeSource                 String?
  submittedAt               DateTime?
  submittedById             String?
  reviewedAt                DateTime?
  reviewedById              String?
  /// Changes-requested note / rejection or unpublish reason (shown to the mandal).
  reviewNote                String?
  liveAt                    DateTime?
  /// The registration this event was requested in (null for events added later).
  registrationId            String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feePayments       EventFeePayment[]
  declarations      LegalDeclaration[]
  timeSlots         TimeSlot[]
  tokens            Token[]
  visitors          Visitor[]
  assignments       EventAssignment[]
  applications      VolunteerApplication[]
  scanLogs          ScanLog[]
  donations         Donation[]
  expenses          Expense[]
  auditLogs         AuditLog[]
  passOrders        PassOrder[]
  sponsors          Sponsor[]
  partnerCampaigns  PartnerCampaign[]
  photos            EventPhoto[]
  priceRules        PriceRule[]
  reviews           VisitorReview[]
  stallTypes        StallType[]
  stallBookings     StallBooking[]
  bloggerPromotions BloggerPromotion[]
  programmeDays     ProgrammeDay[]
  slugAliases       EventSlugAlias[]
  competitions      Competition[]
  artworks          Artwork[]
  programmeItems    ProgrammeItem[]

  @@index([organizationId])
  @@index([state, city])
  @@index([approvalStatus, submittedAt])
  @@map("events")
}

// Event-scoped role: a volunteer assigned to Ganesh Utsav 2026 gets nothing on
// Durga Puja 2026 unless separately assigned.
model EventAssignment {
  id           String           @id @default(uuid())
  eventId      String
  userId       String
  roleId       String
  status       MembershipStatus @default(ACTIVE)
  assignedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id])

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_assignments")
}

model VolunteerApplication {
  id             String            @id @default(uuid())
  userId         String
  organizationId String
  eventId        String?
  message        String?
  status         ApplicationStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user         User         @relation("ApplicationUser", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([userId])
  @@map("volunteer_applications")
}

// Daily slot template. Issuing a token for (slot, date) copies a concrete
// validFrom/validUntil onto the token — editing a slot later never silently
// changes tokens already in visitors' hands.
model TimeSlot {
  id        String   @id @default(uuid())
  eventId   String
  label     String
  startTime String // "HH:mm" in event timezone
  endTime   String // "HH:mm"; <= startTime means the slot crosses midnight
  capacity  Int?
  // Price per person for public pass booking; 0 = free booking.
  price     Decimal  @default(0) @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tokens     Token[]
  passOrders PassOrder[]

  @@index([eventId])
  @@map("time_slots")
}

model Visitor {
  id        String   @id @default(uuid())
  eventId   String
  name      String?
  mobile    String?
  createdAt DateTime @default(now())

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tokens Token[]

  @@index([eventId])
  @@map("visitors")
}

model Token {
  id                 String      @id @default(uuid())
  eventId            String
  // Human-readable, printed under the QR. Sequential, so NOT a secret.
  tokenCode          String
  // 128-bit random handle carried in the QR together with an HMAC signature.
  // Never derivable from tokenCode; the signature is recomputable, not stored.
  secureToken        String      @unique
  visitorId          String?
  timeSlotId         String?
  /// Set for a programme ticket (online order for one programme item).
  programmeItemId    String?
  visitorCount       Int         @default(1)
  status             TokenStatus @default(ACTIVE)
  validFrom          DateTime
  validUntil         DateTime
  issuedAt           DateTime    @default(now())
  issuedById         String?
  usedAt             DateTime?
  usedById           String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  event              Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  visitor            Visitor?       @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  timeSlot           TimeSlot?      @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  programmeItem      ProgrammeItem? @relation(fields: [programmeItemId], references: [id], onDelete: SetNull)
  issuedBy           User?          @relation("TokenIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  usedBy             User?          @relation("TokenUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  cancelledBy        User?          @relation("TokenCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  scanLogs           ScanLog[]
  // Set when the token was minted by an online pass order / issued for a donation.
  passOrderId        String?
  donationId         String?
  donation           Donation?      @relation(fields: [donationId], references: [id], onDelete: SetNull)
  /// Partners printed on this pass (snapshot of what was paid for).
  sponsorIds         String[]       @default([])
  /// Platform promotional-partner campaigns printed on this pass (snapshot of what was paid for).
  partnerCampaignIds String[]       @default([])
  passOrder          PassOrder?     @relation(fields: [passOrderId], references: [id], onDelete: SetNull)

  @@unique([eventId, tokenCode])
  @@index([passOrderId])
  @@index([eventId, status])
  @@index([eventId, validFrom, validUntil])
  @@index([eventId, timeSlotId])
  @@index([programmeItemId])
  @@map("tokens")
}

// Every scan attempt, successful or not. Also the idempotency store: a retried
// request with the same (userId, idempotencyKey) replays the stored result.
// A partial unique index (migration SQL) allows at most ONE non-voided SUCCESS
// per token — the database-level backstop behind the atomic UPDATE.
model ScanLog {
  id             String     @id @default(uuid())
  tokenId        String?
  eventId        String?
  userId         String
  scanTime       DateTime   @default(now())
  result         ScanResult
  failureReason  String?
  method         ScanMethod @default(QR)
  idempotencyKey String?
  // sha256(eventId | scanned payload). A replay is only served when the retry
  // is the same request — a reused key on a different token is refused.
  requestHash    String?
  ipAddress      String?
  userAgent      String?
  // Set only by the audited admin recovery workflow (token reactivation).
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime   @default(now())

  token Token? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([eventId, scanTime])
  @@index([eventId, userId, scanTime])
  @@index([tokenId])
  @@map("scan_logs")
}

model Donation {
  id               String         @id @default(uuid())
  eventId          String
  /// null only for an anonymous donation (gupt daan) — the name is never stored then.
  donorName        String?
  /// Anonymous donation: no name on the receipt, list or share link (CHECK keeps donorName null).
  isAnonymous      Boolean        @default(false)
  donorMobile      String?
  donorEmail       String?
  amount           Decimal        @db.Decimal(12, 2)
  currency         String         @default("INR")
  method           DonationMethod
  paymentStatus    PaymentStatus  @default(PENDING)
  paymentProvider  String         @default("manual")
  paymentReference String?
  providerOrderId  String?
  receiptNo        String?
  /// Random key for the public, shareable receipt link (/r/<id>?k=…).
  shareKey         String?        @unique
  donatedAt        DateTime       @default(now())
  notes            String?
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  passes    Token[]
  taxRecord DonationTaxRecord?

  @@unique([eventId, receiptNo])
  @@unique([paymentProvider, providerOrderId])
  @@index([eventId, donatedAt])
  @@map("donations")
}

// eventId null = a mandal-wide expense (rent, electricity, annual puja…)
// that belongs to no single festival; it still counts in the annual P&L.
model Expense {
  id             String   @id @default(uuid())
  organizationId String
  eventId        String?
  category       String
  description    String
  amount         Decimal  @db.Decimal(12, 2)
  expenseDate    DateTime @db.Date
  vendor         String?
  receiptRef     String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([eventId, expenseDate])
  @@index([organizationId, expenseDate])
  @@map("expenses")
}

// Administrative audit trail (who/what/when/which event/before/after/reason).
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  eventId        String?
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  reason         String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([eventId, createdAt])
  @@map("audit_logs")
}

// A visitor's public booking. PENDING orders hold slot capacity until
// expiresAt so a slot can't be oversold while people are paying; a paid order
// mints its passes exactly once: one QR per person (perPersonPasses) or one
// group QR admitting visitorCount people.
// The buyer reads the order with its random accessKey — no account needed.
model PassOrder {
  id                  String          @id @default(uuid())
  eventId             String
  /// Exactly one of timeSlotId (day pass) / programmeItemId (programme ticket) is set (CHECK).
  timeSlotId          String?
  programmeItemId     String?
  validFrom           DateTime
  validUntil          DateTime
  visitorCount        Int
  buyerName           String
  buyerMobile         String
  buyerEmail          String?
  unitPrice           Decimal         @db.Decimal(10, 2)
  /// Peak-pricing rule that set unitPrice (null = the slot's base price).
  priceRuleLabel      String?
  /// Taxable value (price × people, ex-GST).
  baseAmount          Decimal         @default(0) @db.Decimal(12, 2)
  gstRateBps          Int             @default(0)
  gstAmount           Decimal         @default(0) @db.Decimal(12, 2)
  gstBearer           String?
  invoiceNo           String?
  /// Total charged to the visitor (base + GST).
  amount              Decimal         @db.Decimal(12, 2)
  currency            String          @default("INR")
  status              PassOrderStatus @default(PENDING)
  paymentProvider     String
  providerOrderId     String?
  paymentReference    String?
  accessKey           String          @unique
  perPersonPasses     Boolean         @default(true)
  /// Blogger promotion whose referral code/link brought this booking (commission on payment).
  referralPromotionId String?
  /// Set once the "your festival is today" push reminder went out (never sent twice).
  reminderSentAt      DateTime?
  expiresAt           DateTime
  paidAt              DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  timeSlot          TimeSlot?         @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  programmeItem     ProgrammeItem?    @relation(fields: [programmeItemId], references: [id], onDelete: Restrict)
  tokens            Token[]
  review            VisitorReview?
  pushLinks         PushPassLink[]
  referralPromotion BloggerPromotion? @relation(fields: [referralPromotionId], references: [id], onDelete: SetNull)

  @@unique([paymentProvider, providerOrderId])
  @@unique([eventId, invoiceNo], map: "pass_orders_event_invoice_key")
  @@index([eventId, status])
  @@index([timeSlotId, validFrom, status])
  @@index([programmeItemId, status])
  @@index([referralPromotionId])
  @@map("pass_orders")
}

// One-time codes sent by email. Only an HMAC of the code is stored; a new code
// supersedes older unconsumed ones; 5 wrong attempts burns it.
model EmailOtp {
  id         String     @id @default(uuid())
  userId     String
  purpose    OtpPurpose
  codeHash   String
  sentTo     String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("email_otps")
}

// Collaboration partners / sponsors (e.g. a jeweller sponsoring the pandal).
// eventId null = shown on every festival of the mandal. The logo is a small
// raster image kept in the row and served by GET /public/sponsors/:id/logo.
model Sponsor {
  id             String      @id @default(uuid())
  organizationId String
  eventId        String?
  name           String
  tier           SponsorTier @default(PARTNER)
  tagline        String?
  bannerText     String?
  websiteUrl     String?
  logo           Bytes?
  logoType       String?
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)
  /// Paid promotion: logo + tagline printed on every pass (fee per pass).
  showOnPasses   Boolean     @default(false)
  passesPrinted  Int         @default(0)
  printFeesPaise Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@index([eventId])
  @@map("sponsors")
}

// ─── Platform billing: prepaid token credit ─────────────────────────────
// Money is integer paise. Commission is basis points (100 = 1%).
// fee per person admitted = round(tokenPrice × commissionBps / 10000).

model PlatformSettings {
  id                          String    @id @default("default")
  defaultTokenPricePaise      Int       @default(10000)
  defaultCommissionBps        Int       @default(100)
  lowCreditThresholdPaise     Int       @default(20000)
  welcomeCreditPaise          Int       @default(10000)
  /// Default promotional-partner rate per printed pass (paid by the partner, not the mandal).
  sponsorPassFeePaise         Int       @default(50)
  /// Gateway fee deducted from the mandal's share on online payments (bps).
  gatewayFeeBps               Int       @default(0)
  /// Pass print layout for mandals without an override: AUTO | A4 | THERMAL_80 | THERMAL_58.
  /// AUTO = A4 when a pass carries 2+ ads (sponsors + platform partners), else THERMAL_80.
  defaultPassPrintFormat      String    @default("AUTO")
  /// Yearly fee for a mandal landing page at /m/<slug>, for mandals without an override.
  landingPageYearlyPricePaise Int       @default(99900)
  /// Registration fee per event (each event is paid separately) when no festival-type / mandal rate applies.
  defaultEventFeePaise        Int       @default(49900)
  /// Field-agent referral: fixed amount per mandal, earned when it pays its first event fee.
  agentReferralFeePaise       Int       @default(20000)
  /// Field-agent commission on every paid event fee (bps of the fee).
  agentCommissionBps          Int       @default(0)
  /// Platform fee on every paid stall booking (bps of the stall rent, before GST).
  stallCommissionBps          Int       @default(500)
  /// Platform fee on every paid competition entry (bps of the entry fee, before GST).
  competitionCommissionBps    Int       @default(500)
  /// Blogger referral commission on a paid pass booking: PERCENT (bps of the ex-GST ticket value) or FIXED (paise per booking).
  referralCommissionMode      String    @default("PERCENT")
  referralCommissionValue     Int       @default(500)
  /// 80G: cash donations above this (paise) get no deduction (s.80G(5D) — ₹2,000 today). CA review.
  tax80GCashLimitPaise        Int       @default(200000)
  /// Form 10BD / 10BE due date after the financial year ends, as MM-DD (31 May today). CA review.
  tax10BDDueMonthDay          String    @default("05-31")
  /// Super-admin alerts: everything submitted after this moment is still to be announced (see platform-alerts).
  alertsCheckedAt             DateTime?
  /// Extra addresses (comma-separated) that get the "waiting for review" emails besides every super admin.
  alertEmails                 String?
  updatedAt                   DateTime  @updatedAt
  updatedById                 String?

  @@map("platform_settings")
}

/// One per mandal. creditBalancePaise has a CHECK (>= 0) — the database
/// itself refuses any debit that would overdraw.
model OrgBilling {
  organizationId              String   @id
  creditBalancePaise          Int      @default(0)
  tokenPricePaise             Int?
  commissionBps               Int?
  lowCreditThresholdPaise     Int?
  /// Partner rate per pass at this mandal (null = platform default).
  sponsorPassFeePaise         Int?
  /// Pass print layout, set by the super admin (null = platform default). The mandal can't change it.
  passPrintFormat             String?
  /// Landing page yearly fee at this mandal (null = platform default).
  landingPageYearlyPricePaise Int?
  /// Per-event registration fee at this mandal (null = festival type / platform default).
  eventFeePaise               Int?
  /// Platform fee on stall bookings at this mandal (null = platform default).
  stallCommissionBps          Int?
  totalTokens                 Int      @default(0)
  totalSponsorFeesPaise       Int      @default(0)
  totalPersons                Int      @default(0)
  totalFeesPaise              Int      @default(0)
  totalRechargedPaise         Int      @default(0)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_billing")
}

/// Append-only ledger: every change to a mandal's credit (+ recharge / − fee).
model CreditTransaction {
  id                 String       @id @default(uuid())
  organizationId     String
  type               CreditTxType
  amountPaise        Int
  balanceAfterPaise  Int
  eventId            String?
  source             String?
  tokenCount         Int          @default(0)
  personCount        Int          @default(0)
  unitFeePaise       Int?
  sponsorFeePaise    Int          @default(0)
  sponsorIds         String[]     @default([])
  /// Platform partner campaigns charged (to the partner's wallet) for these passes.
  partnerCampaignIds String[]     @default([])
  tokenPricePaise    Int?
  commissionBps      Int?
  reference          String?
  note               String?
  passOrderId        String?
  rechargeId         String?
  createdById        String?
  createdAt          DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([type, createdAt])
  @@index([passOrderId])
  @@map("credit_transactions")
}

model CreditRecharge {
  id               String          @id @default(uuid())
  organizationId   String
  amountPaise      Int
  status           PassOrderStatus @default(PENDING)
  paymentProvider  String
  providerOrderId  String?
  paymentReference String?
  createdById      String?
  paidAt           DateTime?
  expiresAt        DateTime
  createdAt        DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("credit_recharges")
}

// ─── Split payments: mandal payout account + settlement ledger ─────────
// Sensitive numbers (bank account, PANs) are AES-256-GCM encrypted; only the
// last 4 characters are ever returned by the API.
model PayoutAccount {
  organizationId     String              @id
  entityType         PayoutEntityType
  /// Registered only: TRUST, SOCIETY, SECTION8, PARTNERSHIP, PROPRIETORSHIP, OTHER
  registeredType     String?
  legalName          String
  registrationNumber String?
  orgPanEnc          String?
  orgPanLast4        String?
  gstin              String?
  reg80G             String?
  reg12A             String?
  addressLine        String
  city               String
  state              String
  pincode            String
  contactName        String
  contactRole        String
  contactPhone       String
  contactEmail       String
  signatoryPanEnc    String
  signatoryPanLast4  String
  bankHolderName     String
  bankAccountEnc     String
  bankAccountLast4   String
  ifsc               String
  accountType        String
  proof              Bytes?
  proofType          String?
  status             PayoutAccountStatus @default(PENDING)
  reviewNote         String?
  reviewedById       String?
  reviewedAt         DateTime?
  /// e.g. Razorpay Route linked account id, once registered with the gateway.
  gatewayAccountId   String?
  consentAt          DateTime
  submittedById      String
  submittedAt        DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payout_accounts")
}

/// One row per online payment: who gets what.
model PaymentSettlement {
  id                String           @id @default(uuid())
  organizationId    String
  eventId           String?
  sourceType        String
  sourceId          String           @unique
  grossPaise        Int
  gatewayFeePaise   Int
  commissionPaise   Int
  netPaise          Int
  /// GST inside the gross (part of the mandal's net — the mandal remits it).
  gstPaise          Int              @default(0)
  status            SettlementStatus @default(PENDING_PAYOUT)
  payoutId          String?
  gatewayTransferId String?
  createdAt         DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payout       Payout?      @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@map("payment_settlements")
}

/// Money actually transferred to a mandal (manual UTR now; gateway transfer later).
model Payout {
  id             String   @id @default(uuid())
  organizationId String
  amountPaise    Int
  reference      String
  note           String?
  createdById    String?
  paidAt         DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settlements  PaymentSettlement[]

  @@index([organizationId, paidAt])
  @@map("payouts")
}

// ─── Promotional partners (brands) ─────────────────────────────────────
// Brands deal with the PLATFORM, not the mandal: the super admin approves the
// account and each campaign, the partner pays per pass printed with its logo
// from a prepaid wallet, and the platform keeps 100% of it. walletBalancePaise
// has a CHECK (>= 0). See PartnerBillingService.

model Partner {
  id                  String        @id @default(uuid())
  name                String
  legalName           String?
  gstin               String?
  contactName         String
  contactEmail        String
  contactPhone        String
  websiteUrl          String?
  tagline             String?
  logo                Bytes?
  logoType            String?
  status              PartnerStatus @default(PENDING)
  reviewNote          String?
  reviewedAt          DateTime?
  walletBalancePaise  Int           @default(0)
  totalRechargedPaise Int           @default(0)
  totalSpentPaise     Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  users        User[]
  campaigns    PartnerCampaign[]
  transactions PartnerWalletTransaction[]
  recharges    PartnerRecharge[]

  @@index([status, createdAt])
  @@map("partners")
}

/// A partner's request to be printed on one mandal's passes (eventId null =
/// every festival of that mandal). ratePaise is locked once APPROVED.
model PartnerCampaign {
  id             String                @id @default(uuid())
  partnerId      String
  organizationId String
  eventId        String?
  /// Short promo line printed on the pass (≤ 120 chars).
  message        String
  startDate      DateTime              @db.Date
  endDate        DateTime              @db.Date
  maxPasses      Int?
  ratePaise      Int
  status         PartnerCampaignStatus @default(REQUESTED)
  passesPrinted  Int                   @default(0)
  spentPaise     Int                   @default(0)
  reviewNote     String?
  reviewedById   String?
  reviewedAt     DateTime?
  approvedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  partner      Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([partnerId, createdAt])
  @@index([status, createdAt])
  @@map("partner_campaigns")
}

/// Append-only partner wallet ledger (+ recharge / − pass print / + refund).
model PartnerWalletTransaction {
  id                String        @id @default(uuid())
  partnerId         String
  type              PartnerTxType
  amountPaise       Int
  balanceAfterPaise Int
  campaignId        String?
  organizationId    String?
  eventId           String?
  passOrderId       String?
  rechargeId        String?
  tokenCount        Int           @default(0)
  note              String?
  createdById       String?
  createdAt         DateTime      @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@index([passOrderId])
  @@index([type, createdAt])
  @@map("partner_wallet_transactions")
}

model PartnerRecharge {
  id               String          @id @default(uuid())
  partnerId        String
  amountPaise      Int
  status           PassOrderStatus @default(PENDING)
  paymentProvider  String
  providerOrderId  String?
  paymentReference String?
  createdById      String?
  paidAt           DateTime?
  expiresAt        DateTime
  createdAt        DateTime        @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@map("partner_recharges")
}

// ─── Images: mandal logo/banner + festival photo gallery ───────────────
// Bytes are reached only through the ImageStore interface
// (src/common/images/image-store.ts). The DB-backed implementation keeps them
// in stored_images; an S3/R2 store would keep only the key on callers' rows.

model StoredImage {
  key            String   @id
  organizationId String?
  mimeType       String
  sizeBytes      Int
  bytes          Bytes
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("stored_images")
}

/// One festival photo. sizeBytes = full image + thumbnail (counts toward the
/// mandal's gallery quota). Private by default; isPublic photos get a public URL.
model EventPhoto {
  id             String    @id @default(uuid())
  organizationId String
  eventId        String
  imageKey       String
  thumbKey       String?
  mimeType       String
  width          Int
  height         Int
  sizeBytes      Int
  caption        String?
  isPublic       Boolean   @default(false)
  takenAt        DateTime?
  uploadedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([organizationId, createdAt])
  @@index([eventId, isPublic])
  @@map("event_photos")
}

// ─── Paid mandal landing page (/m/<slug>) ──────────────────────────────
// Served only while paidUntil > now AND enabled. paidUntil moves only through
// a confirmed LandingPurchase or an audited super-admin grant/revoke — the
// mandal's own update endpoint can't touch it.

model LandingPage {
  organizationId   String    @id
  enabled          Boolean   @default(true)
  paidUntil        DateTime?
  headline         String?
  about            String?
  /// Up to 6 short bullet items.
  highlights       String[]  @default([])
  contactPhone     String?
  contactEmail     String?
  instagramUrl     String?
  facebookUrl      String?
  youtubeUrl       String?
  whatsappNumber   String?
  /// Empty = every active/upcoming public festival.
  featuredEventIds String[]  @default([])
  /// Empty = the latest public photos. Only photos that are (still) public are ever shown.
  photoIds         String[]  @default([])
  themeColor       String    @default("saffron")
  /// Section order / visibility / variant: [{ id, visible, variant }]. Null = the default layout.
  /// Always read through normalizeLayout() (landing-layout.ts) — unknown ids dropped, missing ones appended.
  layout           Json?
  totalPaidPaise   Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([paidUntil])
  @@map("landing_pages")
}

/// One yearly landing page payment (demo gateway today, like CreditRecharge).
model LandingPurchase {
  id               String          @id @default(uuid())
  organizationId   String
  amountPaise      Int
  years            Int             @default(1)
  status           PassOrderStatus @default(PENDING)
  paymentProvider  String
  providerOrderId  String?
  paymentReference String?
  createdById      String?
  /// paidUntil after this payment was applied.
  paidUntil        DateTime?
  paidAt           DateTime?
  expiresAt        DateTime
  createdAt        DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([status, paidAt])
  @@map("landing_purchases")
}

// ─── Peak-day pricing ──────────────────────────────────────────────────
// Date-based overrides of a slot's base price. Resolved in ONE place
// (src/common/pricing.ts): DATES rules beat WEEKENDS rules; within the
// winning tier the highest resulting price wins (ties: oldest rule).

enum PriceRuleKind {
  DATES
  WEEKENDS
}

model PriceRule {
  id              String        @id @default(uuid())
  eventId         String
  label           String
  kind            PriceRuleKind
  /// DATES only: calendar dates in the event's timezone.
  dates           DateTime[]    @db.Date
  /// Empty = every slot of the event.
  timeSlotIds     String[]      @default([])
  /// Exactly one of fixedPricePaise / upliftBps is set (CHECK).
  fixedPricePaise Int?
  upliftBps       Int?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("price_rules")
}

// ─── Platform registration control: mandal registrations, per-event review & fee ───
// See docs/ARCHITECTURE.md "Registration, review & event fees".

enum EventApprovalStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED_AWAITING_PAYMENT
  LIVE
  REJECTED
}

enum MandalRegistrationStatus {
  /// Self-registered: waiting for the applicant's email code.
  PENDING_VERIFICATION
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum EventFeeStatus {
  PENDING
  PAID
  WAIVED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
}

enum AgentLedgerType {
  EARNED
  PAID
  REVERSED
}

/// A mandal asking to join (self, via a field agent, or entered by the super admin).
model MandalRegistration {
  id              String                   @id @default(uuid())
  status          MandalRegistrationStatus @default(PENDING_REVIEW)
  /// SELF | AGENT
  source          String                   @default("SELF")
  orgName         String
  state           String?
  city            String?
  address         String?
  contactName     String
  contactMobile   String
  contactEmail    String
  applicantUserId String
  agentId         String?
  referralCode    String?
  /// Requested events: [{ festivalType, custom?: {name, group, description}, name, startDate, endDate, location?, venueAddress?, quotedFeePaise, feeSource }]
  events          Json
  reviewNote      String?
  reviewedById    String?
  reviewedAt      DateTime?
  submittedAt     DateTime?
  organizationId  String?                  @unique
  createdById     String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  applicant    User               @relation("RegistrationApplicant", fields: [applicantUserId], references: [id], onDelete: Cascade)
  agent        Agent?             @relation(fields: [agentId], references: [id], onDelete: SetNull)
  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  declarations LegalDeclaration[]

  @@index([status, createdAt])
  @@index([agentId, createdAt])
  @@index([applicantUserId])
  @@map("mandal_registrations")
}

/// "My event isn't listed": a mandal-proposed festival type. Merged into the public catalog only when inCatalog.
model CustomFestivalType {
  key            String    @id
  label          String
  group          String
  description    String?
  defaultPrefix  String
  /// PENDING | APPROVED | REJECTED
  status         String    @default("PENDING")
  inCatalog      Boolean   @default(false)
  organizationId String?
  registrationId String?
  createdById    String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([inCatalog])
  @@index([organizationId])
  @@map("custom_festival_types")
}

/// Super-admin event fee by festival type (scope TYPE) or catalog group (scope GROUP).
model EventFeeRate {
  id        String   @id @default(uuid())
  /// TYPE | GROUP
  scope     String
  key       String
  feePaise  Int
  updatedAt DateTime @updatedAt

  @@unique([scope, key])
  @@map("event_fee_rates")
}

/// One event-fee payment attempt / settlement. The opaque `token` is the public
/// pay link (/pay/event-fee/<token>). At most one PAID/WAIVED row per event
/// (partial unique index, migration SQL).
model EventFeePayment {
  id               String         @id @default(uuid())
  eventId          String
  organizationId   String
  amountPaise      Int
  token            String         @unique
  status           EventFeeStatus @default(PENDING)
  /// ONLINE | CASH | BANK_TRANSFER | WAIVER
  method           String?
  paymentProvider  String?
  providerOrderId  String?
  paymentReference String?
  note             String?
  expiresAt        DateTime
  paidAt           DateTime?
  recordedById     String?
  refundedAt       DateTime?
  refundReason     String?
  refundedById     String?
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([status, paidAt])
  @@map("event_fee_payments")
}

/// The content-policy declaration a registrant/submitter ticked (version + who + when + IP).
model LegalDeclaration {
  id             String   @id @default(uuid())
  version        String
  /// REGISTRATION | EVENT_SUBMISSION
  context        String
  registrationId String?
  eventId        String?
  acceptedById   String?
  /// Agent filing on the mandal's behalf.
  onBehalf       Boolean  @default(false)
  ipAddress      String?
  userAgent      String?
  acceptedAt     DateTime @default(now())

  registration MandalRegistration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  event        Event?              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([eventId])
  @@map("legal_declarations")
}

/// Field agent: visits mandals and registers them; earns referral + optional commission.
model Agent {
  id               String      @id @default(uuid())
  name             String
  phone            String
  email            String
  /// Short unique referral code, e.g. RAKESH7.
  code             String      @unique
  status           AgentStatus @default(ACTIVE)
  /// Per-agent overrides (null = platform default).
  referralFeePaise Int?
  commissionBps    Int?
  createdById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  users         User[]
  registrations MandalRegistration[]
  organizations Organization[]
  ledger        AgentLedgerEntry[]
  payouts       AgentPayout[]

  @@map("agents")
}

/// Append-only agent earnings ledger. EARNED rows are positive (REGISTRATION or
/// COMMISSION); a refund adds a REVERSED row and stamps reversedAt on the EARNED
/// one; payouts are PAID rows. Partial unique indexes (migration SQL) make
/// earning idempotent: one live REGISTRATION per mandal, one COMMISSION per payment.
model AgentLedgerEntry {
  id                String          @id @default(uuid())
  agentId           String
  type              AgentLedgerType
  /// REGISTRATION | COMMISSION | PAYOUT
  kind              String
  amountPaise       Int
  organizationId    String?
  eventId           String?
  eventFeePaymentId String?
  payoutId          String?
  reversedAt        DateTime?
  reversesId        String?
  note              String?
  createdById       String?
  createdAt         DateTime        @default(now())

  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([agentId, createdAt])
  @@index([organizationId])
  @@map("agent_ledger_entries")
}

model AgentPayout {
  id          String   @id @default(uuid())
  agentId     String
  amountPaise Int
  paidOn      DateTime @db.Date
  reference   String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, paidOn])
  @@map("agent_payouts")
}

/// Single-use "set your password" link (agent-filed registrations). Only a hash is stored.
model PasswordSetupToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_setup_tokens")
}

// ─── Visitor reviews, photos & selfies (moderated by the mandal) ──────────
// Only a PAID PassOrder holder (order id + accessKey) can post, one review per
// order. Nothing is public until the mandal approves it.

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

model VisitorReview {
  id             String       @id @default(uuid())
  organizationId String
  eventId        String
  passOrderId    String       @unique
  rating         Int
  text           String?
  displayName    String
  status         ReviewStatus @default(PENDING)
  /// Auto-screening (abuse words, links, phone numbers, emails) — still goes to the queue, highlighted.
  flagged        Boolean      @default(false)
  flagReasons    String[]     @default([])
  featured       Boolean      @default(false)
  featuredAt     DateTime?
  consentVersion String
  consentAt      DateTime
  moderatedById  String?
  moderatedAt    DateTime?
  moderationNote String?
  /// Open (unresolved) public reports. At REVIEW_REPORT_HIDE_THRESHOLD the review is auto-hidden.
  reportCount    Int          @default(0)
  autoHiddenAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  passOrder    PassOrder      @relation(fields: [passOrderId], references: [id], onDelete: Cascade)
  photos       ReviewPhoto[]
  reports      ReviewReport[]

  @@index([organizationId, status, createdAt])
  @@index([eventId, status, createdAt])
  @@index([reportCount])
  @@map("visitor_reviews")
}

/// A visitor photo/selfie on a review. sizeBytes (full + thumb) counts toward the mandal's 300 MB quota.
/// Shown publicly only while approved AND its review is APPROVED.
model ReviewPhoto {
  id             String   @id @default(uuid())
  reviewId       String
  organizationId String
  imageKey       String
  thumbKey       String?
  mimeType       String
  width          Int
  height         Int
  sizeBytes      Int
  approved       Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  review       VisitorReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([organizationId, approved, createdAt])
  @@map("review_photos")
}

/// A public "Report" on a review. One per reporter fingerprint (hashed IP) per review.
model ReviewReport {
  id           String    @id @default(uuid())
  reviewId     String
  reason       String
  note         String?
  reporterHash String
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  review VisitorReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reporterHash])
  @@index([reviewId, resolvedAt])
  @@map("review_reports")
}

// ─── Achievements, badges & trophies (landing page "Trophies & recognition") ──

model Achievement {
  id             String    @id @default(uuid())
  organizationId String
  title          String
  year           Int?
  awardedBy      String?
  description    String?
  /// TROPHY | MEDAL | STAR | RIBBON | CERTIFICATE | CROWN
  icon           String    @default("TROPHY")
  imageKey       String?
  thumbKey       String?
  imageMimeType  String?
  /// Full + thumbnail bytes; counts toward the mandal's 300 MB quota.
  imageSizeBytes Int       @default(0)
  imageUpdatedAt DateTime?
  /// 0 everywhere = default order (newest year first); set 1..n once the mandal reorders.
  sortOrder      Int       @default(0)
  isVisible      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, sortOrder])
  @@map("achievements")
}

// ─── Stall booking ─────────────────────────────────────────────────────
// Vendors (their own login, like promotional partners) book stalls at a
// festival: the mandal sets stall types with a count and price, a vendor pays
// online, and the platform keeps stallCommissionBps of the rent through the
// normal PaymentSettlement split. A PENDING booking with expiresAt in the
// future holds its stalls; capacity is checked under a row lock on the
// stall type (see StallsService.checkCapacity), so a type is never oversold.

enum VendorStatus {
  ACTIVE
  SUSPENDED
}

enum StallCategory {
  FOOD
  SHOPPING
  SERVICES
  EXHIBITOR
  OTHER
}

model Vendor {
  id           String         @id @default(uuid())
  businessName String
  contactName  String
  contactEmail String
  contactPhone String
  category     StallCategory?
  description  String?
  city         String?
  gstin        String?
  status       VendorStatus   @default(ACTIVE)
  statusNote   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  users    User[]
  bookings StallBooking[]

  @@index([status, createdAt])
  @@map("vendors")
}

model StallType {
  id             String        @id @default(uuid())
  organizationId String
  eventId        String
  name           String
  category       StallCategory
  description    String?
  /// Free text, e.g. "10 × 10 ft".
  size           String?
  pricePaise     Int
  totalCount     Int
  isActive       Boolean       @default(true)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookings     StallBooking[]

  @@index([eventId, isActive, sortOrder])
  @@map("stall_types")
}

model StallBooking {
  id               String          @id @default(uuid())
  organizationId   String
  eventId          String
  stallTypeId      String
  vendorId         String
  createdById      String
  quantity         Int
  unitPricePaise   Int
  basePaise        Int
  gstRateBps       Int             @default(0)
  gstPaise         Int             @default(0)
  amountPaise      Int
  /// Platform fee locked at booking time (bps of basePaise) and its amount.
  commissionBps    Int
  platformFeePaise Int
  businessName     String
  contactName      String
  contactPhone     String
  contactEmail     String?
  /// What the vendor will sell / show.
  products         String?
  status           PassOrderStatus @default(PENDING)
  paymentProvider  String
  providerOrderId  String?
  paymentReference String?
  invoiceNo        String?
  /// Assigned by the mandal after payment, e.g. "F-04, F-05".
  stallNumbers     String?
  mandalNote       String?
  /// Cancellation of a PAID booking by the mandal: refund (0..amountPaise) goes back to the vendor;
  /// the platform fee is returned pro rata and the mandal's share is reduced (STALL_REFUND settlement).
  cancelledAt      DateTime?
  cancelledById    String?
  cancelReason     String?
  refundPaise      Int             @default(0)
  refundReference  String?
  /// GST credit note for the refunded part (only when the booking had a tax invoice and a refund).
  creditNoteNo     String?
  expiresAt        DateTime
  paidAt           DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stallType    StallType    @relation(fields: [stallTypeId], references: [id], onDelete: Restrict)
  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("StallBookingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([paymentProvider, providerOrderId])
  @@unique([eventId, invoiceNo])
  @@index([stallTypeId, status, expiresAt])
  @@index([vendorId, createdAt])
  @@index([eventId, status, createdAt])
  @@index([status, expiresAt])
  @@map("stall_bookings")
}

// ─── Blogger / influencer referrals ─────────────────────────────────────
//
// Bloggers sign themselves up (User.bloggerId → Blogger, no memberships) and
// pick festivals to promote. The super admin approves the blogger and each
// promotion; an approved promotion gets its own referral code. A pass order
// placed with that code (link /f/<event>?ref=CODE) carries referralPromotionId,
// and the commission is credited in the payment transaction — once per order
// (partial unique index), reversed when every pass of the booking is cancelled
// or by the super admin for an off-platform refund. Commissions are paid by the
// platform, not deducted from the mandal's settlement.

enum BloggerStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum PromotionStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum ReferralLedgerType {
  EARNED
  PAID
  REVERSED
}

model Blogger {
  id              String        @id @default(uuid())
  name            String
  email           String
  phone           String
  city            String?
  bio             String?
  youtubeUrl      String?
  instagramHandle String?
  blogUrl         String?
  /// Self-declared audience size, e.g. "45k Instagram followers".
  audience        String?
  status          BloggerStatus @default(PENDING)
  reviewNote      String?
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  users      User[]
  promotions BloggerPromotion[]
  ledger     ReferralLedgerEntry[]
  payouts    BloggerPayout[]

  @@index([status, createdAt])
  @@map("bloggers")
}

model BloggerPromotion {
  id              String          @id @default(uuid())
  bloggerId       String
  eventId         String
  organizationId  String
  /// Referral code, unique platform-wide; assigned when the promotion is approved.
  code            String?         @unique
  status          PromotionStatus @default(PENDING)
  /// Commission override for this promotion (null = platform default): PERCENT (bps) | FIXED (paise per booking).
  commissionMode  String?
  commissionValue Int?
  reviewNote      String?
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  blogger Blogger               @relation(fields: [bloggerId], references: [id], onDelete: Cascade)
  event   Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders  PassOrder[]
  ledger  ReferralLedgerEntry[]

  @@unique([bloggerId, eventId])
  @@index([eventId, status])
  @@index([status, createdAt])
  @@map("blogger_promotions")
}

model ReferralLedgerEntry {
  id          String             @id @default(uuid())
  bloggerId   String
  type        ReferralLedgerType
  /// COMMISSION | PAYOUT
  kind        String
  amountPaise Int
  promotionId String?
  eventId     String?
  passOrderId String?
  payoutId    String?
  reversedAt  DateTime?
  reversesId  String?
  note        String?
  createdById String?
  createdAt   DateTime           @default(now())

  blogger   Blogger           @relation(fields: [bloggerId], references: [id], onDelete: Cascade)
  promotion BloggerPromotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([bloggerId, createdAt])
  @@index([promotionId])
  @@index([passOrderId])
  @@map("referral_ledger_entries")
}

model BloggerPayout {
  id          String   @id @default(uuid())
  bloggerId   String
  amountPaise Int
  paidOn      DateTime @db.Date
  reference   String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  blogger Blogger @relation(fields: [bloggerId], references: [id], onDelete: Cascade)

  @@index([bloggerId, paidOn])
  @@map("blogger_payouts")
}

// ─── 80G donation tax: profile, per-donation tax record, documents, 10BD ─────
//
// The mandal's 80G registration is entered by the mandal and VERIFIED by the
// super admin (who also sets the deduction %). Every donation has a tax record
// whose eligibility the SERVER decides (verified profile, URN validity, not
// anonymous, not refunded, cash limit, donor ID present) — clients can't set
// it. Donor IDs (PAN/Aadhaar/…) are AES-GCM encrypted, shown masked; a keyed
// hash groups one donor's donations for Form 10BD / 10BE without decrypting.
// Receipts and 10BE issues are versioned DonationDocument rows. Form 10BE is
// generated by the income-tax portal after 10BD is filed — we track its issue.

enum TaxProfileStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  REJECTED
}

model OrgTaxProfile {
  organizationId   String           @id
  /// 80G Unique Registration Number (URN), e.g. AAATS1234AF20214.
  urn              String
  urnIssuedOn      DateTime         @db.Date
  validFrom        DateTime         @db.Date
  /// null = no end date on the approval.
  validTo          DateTime?        @db.Date
  orgPanEnc        String
  orgPanLast4      String
  /// Section code as reported in Form 10BD (e.g. "Section 80G").
  sectionCode      String           @default("Section 80G")
  /// Set by the super admin at verification (50 or 100).
  deductionPercent Int?
  status           TaxProfileStatus @default(DRAFT)
  reviewNote       String?
  reviewedById     String?
  reviewedAt       DateTime?
  submittedById    String?
  submittedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("org_tax_profiles")
}

model DonationTaxRecord {
  donationId       String   @id
  organizationId   String
  eventId          String
  /// PAN | AADHAAR | TIN | PASSPORT | VOTER_ID | DRIVING_LICENSE | RATION_CARD
  idType           String?
  idNumberEnc      String?
  idLast4          String?
  /// HMAC of idType+idNumber — groups a donor's donations; never reversible.
  donorIdHash      String?
  donorAddress     String?
  /// Server-decided, re-evaluated on every relevant change.
  eligible         Boolean  @default(false)
  ineligibleReason String?
  deductionPercent Int?
  /// Indian financial year of the donation, e.g. "2026-27".
  financialYear    String
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([organizationId, financialYear, eligible])
  @@index([organizationId, financialYear, donorIdHash])
  @@map("donation_tax_records")
}

model DonationDocument {
  id             String    @id @default(uuid())
  organizationId String
  /// RECEIPT (one donation) | FORM_10BE (one donor, one financial year)
  kind           String
  donationId     String?
  financialYear  String?
  donorIdHash    String?
  /// Receipt number, or the 10BE certificate number from the income-tax portal.
  docNo          String
  version        Int
  /// ISSUED | SUPERSEDED | CANCELLED
  status         String    @default("ISSUED")
  /// The document's content as issued (masked IDs only).
  snapshot       Json
  issuedAt       DateTime  @default(now())
  issuedById     String?
  closedAt       DateTime?
  closeReason    String?

  @@index([organizationId, kind, financialYear])
  @@index([donationId])
  @@map("donation_documents")
}

model Form10BDFiling {
  id             String   @id @default(uuid())
  organizationId String
  financialYear  String
  /// FILED | REVISION_NEEDED (a donation in it changed after filing) | SUPERSEDED (a correction was filed)
  status         String   @default("FILED")
  ackNumber      String
  filedOn        DateTime @db.Date
  filedById      String
  donorCount     Int
  donationCount  Int
  totalPaise     Int
  /// Donation ids included (to detect later changes).
  donationIds    String[]
  revisionNote   String?
  createdAt      DateTime @default(now())

  @@index([organizationId, financialYear])
  @@map("form_10bd_filings")
}

// ─── Instagram photo import ─────────────────────────────────────────────
//
// A mandal admin connects the mandal's OWN Instagram (Instagram Login, Business
// or Creator account — this proves ownership). Syncs list recent posts as
// PENDING media; nothing is shown anywhere until an admin approves a photo, at
// which point its bytes are copied into the ImageStore (Instagram's media URLs
// expire) and it appears in the landing page's Instagram section. Rejected
// posts are remembered so a later sync never offers them again.

enum InstagramConnectionStatus {
  ACTIVE
  EXPIRED
  DISCONNECTED
}

enum InstagramMediaStatus {
  PENDING
  APPROVED
  REJECTED
}

model InstagramConnection {
  organizationId String                    @id
  igUserId       String
  username       String
  accountType    String?
  /// Long-lived token, AES-GCM encrypted; null once disconnected.
  accessTokenEnc String?
  tokenExpiresAt DateTime?
  status         InstagramConnectionStatus @default(ACTIVE)
  connectedById  String
  connectedAt    DateTime                  @default(now())
  lastSyncAt     DateTime?
  lastSyncError  String?
  updatedAt      DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, tokenExpiresAt])
  @@index([igUserId])
  @@map("instagram_connections")
}

model InstagramMedia {
  id             String               @id @default(uuid())
  organizationId String
  /// Instagram's media id (a carousel's children each get their own row).
  igMediaId      String
  /// The post a carousel image belongs to (null for a single-image post).
  parentIgId     String?
  caption        String?
  permalink      String?
  postedAt       DateTime?
  status         InstagramMediaStatus @default(PENDING)
  /// Set once approved (bytes copied into the ImageStore).
  imageKey       String?
  mimeType       String?
  width          Int?
  height         Int?
  sizeBytes      Int                  @default(0)
  sortOrder      Int                  @default(0)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, igMediaId])
  @@index([organizationId, status, postedAt])
  @@map("instagram_media")
}

// ─── Web push notifications ─────────────────────────────────────────────
//
// The API makes its own VAPID key pair on first use (private key AES-GCM
// encrypted) — no environment setup. A browser/phone that allows
// notifications is one PushSubscription (its endpoint is unique): linked to a
// signed-in user (organiser, blogger, vendor…) and/or to visitors' pass orders
// (PushPassLink, proven with the order's access key). Endpoints the push
// service reports gone (404/410) are deleted on the next send.

model PushKeys {
  id            String   @id @default("default")
  publicKey     String
  privateKeyEnc String
  createdAt     DateTime @default(now())

  @@map("push_keys")
}

model PushSubscription {
  id         String    @id @default(uuid())
  endpoint   String    @unique
  p256dh     String
  auth       String
  userId     String?
  userAgent  String?
  /// Site language when it subscribed (en, hi, mr, bn, or, kn) — reminders are written in it.
  lang       String    @default("en")
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user   User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  passes PushPassLink[]

  @@index([userId])
  @@map("push_subscriptions")
}

model PushPassLink {
  subscriptionId String
  passOrderId    String
  createdAt      DateTime @default(now())

  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  passOrder    PassOrder        @relation(fields: [passOrderId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, passOrderId])
  @@index([passOrderId])
  @@map("push_pass_links")
}

// ─── Festival programme / line-up ──────────────────────────────────────
// What happens on each day of a multi-day festival (Durga Puja's ten days,
// Navratri's nine nights): performances, pujas, competitions, chief guests.
// Shown on the public festival page only while the event is public (LIVE +
// ACTIVE/COMPLETED) and the item is published. Times are "HH:mm" in the
// event's timezone, like TimeSlot.

/// Optional per-day heading ("Maha Ashtami", "Day 3 · Colour: Green").
model ProgrammeDay {
  id        String   @id @default(uuid())
  eventId   String
  date      DateTime @db.Date
  title     String?
  subtitle  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, date])
  @@map("programme_days")
}

model ProgrammeItem {
  id              String    @id @default(uuid())
  eventId         String
  date            DateTime  @db.Date
  startTime       String
  endTime         String?
  title           String
  /// PERFORMANCE | PUJA | CULTURAL | COMPETITION | CHIEF_GUEST | WORKSHOP | OTHER
  category        String    @default("PERFORMANCE")
  description     String?
  /// INDOOR | OUTDOOR | null (not said) — shown as a tag, like activity listings.
  setting         String?
  /// Where inside the venue: "Main stage", "Pandal ground", "Community hall".
  stage           String?
  /// "Hindi, Bengali" — free text.
  language        String?
  /// "All ages", "5+", "18+" — free text, shown as given.
  ageLimit        String?
  /// Normalised YouTube / Instagram link (see programme.rules.ts).
  videoUrl        String?
  posterKey       String?
  posterUpdatedAt DateTime?
  /// Counts toward the mandal's image quota (common/images/quota.ts).
  posterSizeBytes Int       @default(0)
  /// Shown in the "Star line-up" strip at the top of the programme.
  isHeadline      Boolean   @default(false)
  /// SCHEDULED | CANCELLED (kept visible with the note, so visitors know).
  status          String    @default("SCHEDULED")
  statusNote      String?
  isPublished     Boolean   @default(true)
  sortOrder       Int       @default(0)
  /// Sold as its own ticket on the booking page (separate from time-slot day passes).
  /// The pass is valid only from startTime to endTime on this item's date.
  ticketed        Boolean   @default(false)
  /// Per person; 0 = free ticket.
  ticketPrice     Decimal   @default(0) @db.Decimal(10, 2)
  /// null = unlimited.
  ticketCapacity  Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event      Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guests     ProgrammeGuest[]
  tokens     Token[]
  passOrders PassOrder[]

  @@index([eventId, date])
  @@map("programme_items")
}

/// An artist / celebrity / chief guest appearing in one programme item.
model ProgrammeGuest {
  id             String    @id @default(uuid())
  itemId         String
  name           String
  /// "Playback singer", "Chief guest", "Dhaki group"…
  role           String?
  bio            String?
  instagramUrl   String?
  photoKey       String?
  photoUpdatedAt DateTime?
  /// Counts toward the mandal's image quota.
  photoSizeBytes Int       @default(0)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  item ProgrammeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("programme_guests")
}

/// A festival's earlier page addresses: old links keep working, and nobody else can take them.
model EventSlugAlias {
  slug      String   @id
  eventId   String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_slug_aliases")
}

// ─── Competitions (swimming, dhunuchi, rangoli, drawing, garba, quiz…) ──
// A festival runs competitions; each has categories (age group / gender /
// event, own fee and spots). Visitors enter without an account and pay online
// (fees are online only); the entry is read back with its random accessKey,
// like a pass order. Paid entries get a bib number; the mandal checks people
// in, assigns heats/lanes, records results and publishes them. The platform
// fee goes through PaymentSettlement (sourceType COMPETITION_ENTRY).

model Competition {
  id                   String    @id @default(uuid())
  organizationId       String
  eventId              String
  name                 String
  /// SWIMMING | RUNNING | DANCE | ART | QUIZ | SPORTS | OTHER (icon and defaults only).
  kind                 String    @default("OTHER")
  /// TIME (lowest wins: swimming, running) | SCORE (highest wins) | RANK (judges place people).
  resultType           String    @default("RANK")
  description          String?
  rules                String?
  date                 DateTime  @db.Date
  startTime            String
  venue                String?
  /// INDOOR | OUTDOOR | null
  setting              String?
  /// Lanes per heat (swimming / running); null = no heats.
  lanes                Int?
  registrationOpen     Boolean   @default(false)
  registrationClosesAt DateTime?
  /// Extra declaration every entrant accepts, e.g. "can swim 25 m unaided, no medical condition".
  safetyDeclaration    String?
  isPublished          Boolean   @default(false)
  resultsPublished     Boolean   @default(false)
  /// Bib numbers are given in payment order, per competition.
  bibSeq               Int       @default(0)
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  event      Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categories CompetitionCategory[]
  entries    CompetitionEntry[]

  @@index([eventId])
  @@map("competitions")
}

model CompetitionCategory {
  id            String   @id @default(uuid())
  competitionId String
  /// "50 m freestyle · Under 14 · Girls"
  name          String
  /// ANY | MALE | FEMALE
  gender        String   @default("ANY")
  /// Age on the competition day, inclusive; null = no limit.
  minAge        Int?
  maxAge        Int?
  feePaise      Int      @default(0)
  /// null = unlimited
  capacity      Int?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  entries     CompetitionEntry[]

  @@index([competitionId])
  @@map("competition_categories")
}

model CompetitionEntry {
  id                    String          @id @default(uuid())
  organizationId        String
  eventId               String
  competitionId         String
  categoryId            String
  participantName       String
  dateOfBirth           DateTime        @db.Date
  /// Age on the competition day (stored so later edits to the date don't change eligibility).
  ageOnDay              Int
  /// MALE | FEMALE | OTHER
  gender                String
  phone                 String
  email                 String?
  city                  String?
  /// Required when the participant is under 18.
  guardianName          String?
  guardianPhone         String?
  guardianConsentAt     DateTime?
  emergencyName         String
  emergencyPhone        String
  /// Rules + safety declaration accepted (text snapshot kept for the record).
  declarationText       String
  declarationAcceptedAt DateTime
  basePaise             Int
  gstRateBps            Int             @default(0)
  gstPaise              Int             @default(0)
  amountPaise           Int
  commissionBps         Int
  platformFeePaise      Int
  status                PassOrderStatus @default(PENDING)
  paymentProvider       String
  providerOrderId       String?
  paymentReference      String?
  invoiceNo             String?
  accessKey             String          @unique
  bibNo                 Int?
  expiresAt             DateTime
  paidAt                DateTime?
  checkedInAt           DateTime?
  checkedInById         String?
  heat                  Int?
  lane                  Int?
  /// FINISHED | DNF | DNS | DQ — null until recorded.
  resultStatus          String?
  /// TIME results in milliseconds.
  resultMs              Int?
  /// SCORE results.
  resultScore           Decimal?        @db.Decimal(10, 2)
  /// Computed for TIME / SCORE, entered for RANK.
  rank                  Int?
  resultNote            String?
  cancelledAt           DateTime?
  cancelledById         String?
  cancelReason          String?
  refundPaise           Int             @default(0)
  refundReference       String?
  creditNoteNo          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  competition Competition         @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  category    CompetitionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([competitionId, bibNo])
  @@unique([paymentProvider, providerOrderId])
  @@unique([eventId, invoiceNo])
  @@index([categoryId, status, expiresAt])
  @@index([competitionId, status])
  @@index([status, expiresAt])
  @@map("competition_entries")
}

// ─── Art gallery (exhibition at the festival) ──────────────────────────
// Each artwork is DISPLAY (shown only) or SALE (price + Available / Reserved
// / Sold). Buyers don't pay through Parvsetu: they send an enquiry (name +
// phone) that the mandal follows up, and the mandal marks the piece sold.
// Images count toward the mandal's 300 MB image quota.

model Artwork {
  id              String    @id @default(uuid())
  organizationId  String
  eventId         String
  title           String
  artistName      String
  artistBio       String?
  artistInstagram String?
  /// Free text: "Oil on canvas", "Terracotta", "Watercolour"…
  medium          String?
  widthCm         Decimal?  @db.Decimal(7, 1)
  heightCm        Decimal?  @db.Decimal(7, 1)
  depthCm         Decimal?  @db.Decimal(7, 1)
  year            Int?
  description     String?
  /// DISPLAY | SALE
  mode            String    @default("DISPLAY")
  /// SALE only (paise).
  pricePaise      Int?
  /// AVAILABLE | RESERVED | SOLD (SALE only; DISPLAY stays AVAILABLE).
  saleStatus      String    @default("AVAILABLE")
  soldAt          DateTime?
  imageKey        String?
  thumbKey        String?
  imageWidth      Int?
  imageHeight     Int?
  /// Full + thumbnail bytes; counts toward the image quota.
  imageSizeBytes  Int       @default(0)
  imageUpdatedAt  DateTime?
  isFeatured      Boolean   @default(false)
  isPublished     Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  enquiries ArtworkEnquiry[]

  @@index([eventId, isPublished])
  @@index([organizationId])
  @@map("artworks")
}

/// "I'm interested" from a visitor. Personal data: only the mandal (GALLERY_MANAGE) sees it.
model ArtworkEnquiry {
  id        String   @id @default(uuid())
  artworkId String
  eventId   String
  name      String
  phone     String
  email     String?
  message   String?
  /// NEW | CONTACTED | CLOSED
  status    String   @default("NEW")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@index([eventId, status, createdAt])
  @@index([artworkId])
  @@map("artwork_enquiries")
}
