// Parvsetu — festival/mandal management.
//
// Tenancy: Organization (mandal) → Event (festival edition). Every operational
// record (token, scan, donation, expense, time slot) carries eventId; access is
// always resolved server-side through AccessService (org membership role ∪
// event assignment role). See docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

// EXPIRED is never stored: it is derived (status ACTIVE and validUntil <= now),
// so an admin extending a window never has to "un-expire" a row.
enum TokenStatus {
  ACTIVE
  USED
  CANCELLED
}

enum ScanResult {
  SUCCESS
  ALREADY_USED
  EXPIRED
  NOT_YET_VALID
  CANCELLED
  INVALID
  WRONG_EVENT
  UNAUTHORIZED
}

enum ScanMethod {
  QR
  MANUAL
}

enum DonationMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id           String     @id @default(uuid())
  name         String
  mobile       String     @unique
  email        String?    @unique
  passwordHash String
  isSuperAdmin Boolean    @default(false)
  status       UserStatus @default(ACTIVE)
  // Bumped on password change / disable — invalidates outstanding JWTs.
  tokenVersion Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships       OrganizationMember[]
  assignments       EventAssignment[]    @relation("AssignmentUser")
  applications      VolunteerApplication[] @relation("ApplicationUser")
  scanLogs          ScanLog[]
  tokensUsed        Token[]              @relation("TokenUsedBy")
  tokensIssued      Token[]              @relation("TokenIssuedBy")
  tokensCancelled   Token[]              @relation("TokenCancelledBy")
  donationsCreated  Donation[]
  expensesCreated   Expense[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  city      String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      OrganizationMember[]
  events       Event[]
  roles        Role[]
  applications VolunteerApplication[]
  auditLogs    AuditLog[]

  @@map("organizations")
}

// Permission catalog is code (src/common/permissions.ts) mirrored into this
// table by the seed, so RolePermission rows have a real FK target.
model Permission {
  key         String           @id
  group       String
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id             String        @id @default(uuid())
  // null = system role (template usable by every organization, immutable via API)
  organizationId String?
  key            String
  name           String
  description    String?
  isSystem       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  OrganizationMember[]
  assignments  EventAssignment[]

  @@unique([organizationId, key])
  @@map("roles")
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

// Org-wide role: applies to every event of the organization (Mandal Admin,
// Report Viewer, Treasurer...).
model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Event {
  id                        String      @id @default(uuid())
  organizationId            String
  name                      String
  // Free-form key so new festivals need no migration (GANESH_UTSAV, DURGA_PUJA, ...).
  festivalType              String
  description               String?
  location                  String?
  startDate                 DateTime    @db.Date
  endDate                   DateTime    @db.Date
  timezone                  String      @default("Asia/Kolkata")
  status                    EventStatus @default(DRAFT)
  tokenPrefix               String
  // Atomic per-event counter for human-readable token codes (PREFIX-YYYY-000001).
  tokenSeq                  Int         @default(0)
  donationReceiptSeq        Int         @default(0)
  volunteerRegistrationOpen Boolean     @default(false)
  maxVisitorsPerToken       Int         @default(10)
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timeSlots    TimeSlot[]
  tokens       Token[]
  visitors     Visitor[]
  assignments  EventAssignment[]
  applications VolunteerApplication[]
  scanLogs     ScanLog[]
  donations    Donation[]
  expenses     Expense[]
  auditLogs    AuditLog[]

  @@index([organizationId])
  @@map("events")
}

// Event-scoped role: a volunteer assigned to Ganesh Utsav 2026 gets nothing on
// Durga Puja 2026 unless separately assigned.
model EventAssignment {
  id         String           @id @default(uuid())
  eventId    String
  userId     String
  roleId     String
  status     MembershipStatus @default(ACTIVE)
  assignedById String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id])

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_assignments")
}

model VolunteerApplication {
  id             String            @id @default(uuid())
  userId         String
  organizationId String
  eventId        String?
  message        String?
  status         ApplicationStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user         User         @relation("ApplicationUser", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([userId])
  @@map("volunteer_applications")
}

// Daily slot template. Issuing a token for (slot, date) copies a concrete
// validFrom/validUntil onto the token — editing a slot later never silently
// changes tokens already in visitors' hands.
model TimeSlot {
  id        String   @id @default(uuid())
  eventId   String
  label     String
  startTime String // "HH:mm" in event timezone
  endTime   String // "HH:mm"; <= startTime means the slot crosses midnight
  capacity  Int?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tokens Token[]

  @@index([eventId])
  @@map("time_slots")
}

model Visitor {
  id        String   @id @default(uuid())
  eventId   String
  name      String?
  mobile    String?
  createdAt DateTime @default(now())

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tokens Token[]

  @@index([eventId])
  @@map("visitors")
}

model Token {
  id                 String      @id @default(uuid())
  eventId            String
  // Human-readable, printed under the QR. Sequential, so NOT a secret.
  tokenCode          String
  // 128-bit random handle carried in the QR together with an HMAC signature.
  // Never derivable from tokenCode; the signature is recomputable, not stored.
  secureToken        String      @unique
  visitorId          String?
  timeSlotId         String?
  visitorCount       Int         @default(1)
  status             TokenStatus @default(ACTIVE)
  validFrom          DateTime
  validUntil         DateTime
  issuedAt           DateTime    @default(now())
  issuedById         String?
  usedAt             DateTime?
  usedById           String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  visitor    Visitor?  @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  timeSlot   TimeSlot? @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  issuedBy   User?     @relation("TokenIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  usedBy     User?     @relation("TokenUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  cancelledBy User?    @relation("TokenCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  scanLogs   ScanLog[]

  @@unique([eventId, tokenCode])
  @@index([eventId, status])
  @@index([eventId, validFrom, validUntil])
  @@index([eventId, timeSlotId])
  @@map("tokens")
}

// Every scan attempt, successful or not. Also the idempotency store: a retried
// request with the same (userId, idempotencyKey) replays the stored result.
// A partial unique index (migration SQL) allows at most ONE non-voided SUCCESS
// per token — the database-level backstop behind the atomic UPDATE.
model ScanLog {
  id             String     @id @default(uuid())
  tokenId        String?
  eventId        String?
  userId         String
  scanTime       DateTime   @default(now())
  result         ScanResult
  failureReason  String?
  method         ScanMethod @default(QR)
  idempotencyKey String?
  // sha256(eventId | scanned payload). A replay is only served when the retry
  // is the same request — a reused key on a different token is refused.
  requestHash    String?
  ipAddress      String?
  userAgent      String?
  // Set only by the audited admin recovery workflow (token reactivation).
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime   @default(now())

  token Token? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([eventId, scanTime])
  @@index([eventId, userId, scanTime])
  @@index([tokenId])
  @@map("scan_logs")
}

model Donation {
  id               String         @id @default(uuid())
  eventId          String
  donorName        String
  donorMobile      String?
  donorEmail       String?
  amount           Decimal        @db.Decimal(12, 2)
  currency         String         @default("INR")
  method           DonationMethod
  paymentStatus    PaymentStatus  @default(PENDING)
  paymentProvider  String         @default("manual")
  paymentReference String?
  providerOrderId  String?
  receiptNo        String?
  donatedAt        DateTime       @default(now())
  notes            String?
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([eventId, receiptNo])
  @@unique([paymentProvider, providerOrderId])
  @@index([eventId, donatedAt])
  @@map("donations")
}

model Expense {
  id          String   @id @default(uuid())
  eventId     String
  category    String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @db.Date
  vendor      String?
  receiptRef  String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([eventId, expenseDate])
  @@map("expenses")
}

// Administrative audit trail (who/what/when/which event/before/after/reason).
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  eventId        String?
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  reason         String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([eventId, createdAt])
  @@map("audit_logs")
}
