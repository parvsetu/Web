// Parvsetu — festival/mandal management.
//
// Tenancy: Organization (mandal) → Event (festival edition). Every operational
// record (token, scan, donation, expense, time slot) carries eventId; access is
// always resolved server-side through AccessService (org membership role ∪
// event assignment role). See docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

// EXPIRED is never stored: it is derived (status ACTIVE and validUntil <= now),
// so an admin extending a window never has to "un-expire" a row.
enum TokenStatus {
  ACTIVE
  USED
  CANCELLED
}

enum ScanResult {
  SUCCESS
  ALREADY_USED
  EXPIRED
  NOT_YET_VALID
  CANCELLED
  INVALID
  WRONG_EVENT
  UNAUTHORIZED
}

enum PassOrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum SponsorTier {
  TITLE
  PLATINUM
  GOLD
  SILVER
  PARTNER
}

enum CreditTxType {
  RECHARGE
  TOKEN_FEE
  REFUND
  ADJUSTMENT
  WELCOME
}

enum PayoutEntityType {
  REGISTERED
  UNREGISTERED
}

enum PayoutAccountStatus {
  PENDING
  VERIFIED
  NEEDS_CORRECTION
  REJECTED
}

enum SettlementStatus {
  PENDING_PAYOUT
  PAID_OUT
}

enum ScanMethod {
  QR
  MANUAL
}

enum DonationMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id           String     @id @default(uuid())
  name         String
  mobile       String     @unique
  email        String?    @unique
  passwordHash String
  isSuperAdmin Boolean    @default(false)
  status       UserStatus @default(ACTIVE)
  // Bumped on password change / disable — invalidates outstanding JWTs.
  tokenVersion Int        @default(0)
  emailVerifiedAt DateTime?
  // Self-registered accounts must verify their email before they can log in.
  requiresEmailVerification Boolean @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships       OrganizationMember[]
  assignments       EventAssignment[]    @relation("AssignmentUser")
  applications      VolunteerApplication[] @relation("ApplicationUser")
  scanLogs          ScanLog[]
  tokensUsed        Token[]              @relation("TokenUsedBy")
  tokensIssued      Token[]              @relation("TokenIssuedBy")
  tokensCancelled   Token[]              @relation("TokenCancelledBy")
  donationsCreated  Donation[]
  expensesCreated   Expense[]
  auditLogs         AuditLog[]
  otps              EmailOtp[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  state     String?
  city      String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      OrganizationMember[]
  events       Event[]
  roles        Role[]
  applications VolunteerApplication[]
  auditLogs    AuditLog[]
  expenses     Expense[]
  sponsors     Sponsor[]
  billing      OrgBilling?
  payoutAccount PayoutAccount?
  settlements  PaymentSettlement[]
  payouts      Payout[]
  creditTransactions CreditTransaction[]
  creditRecharges    CreditRecharge[]

  @@map("organizations")
}

// Permission catalog is code (src/common/permissions.ts) mirrored into this
// table by the seed, so RolePermission rows have a real FK target.
model Permission {
  key         String           @id
  group       String
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id             String        @id @default(uuid())
  // null = system role (template usable by every organization, immutable via API)
  organizationId String?
  key            String
  name           String
  description    String?
  isSystem       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  OrganizationMember[]
  assignments  EventAssignment[]

  @@unique([organizationId, key])
  @@map("roles")
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

// Org-wide role: applies to every event of the organization (Mandal Admin,
// Report Viewer, Treasurer...).
model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Event {
  id                        String      @id @default(uuid())
  organizationId            String
  name                      String
  // Free-form key so new festivals need no migration (GANESH_UTSAV, DURGA_PUJA, ...).
  festivalType              String
  description               String?
  location                  String?
  state                     String?
  city                      String?
  startDate                 DateTime    @db.Date
  endDate                   DateTime    @db.Date
  timezone                  String      @default("Asia/Kolkata")
  status                    EventStatus @default(DRAFT)
  tokenPrefix               String
  // Atomic per-event counter for human-readable token codes (PREFIX-YYYY-000001).
  tokenSeq                  Int         @default(0)
  donationReceiptSeq        Int         @default(0)
  volunteerRegistrationOpen Boolean     @default(false)
  // Visitors can buy/book passes on the public site (prices live on time slots).
  publicBookingEnabled      Boolean     @default(false)
  // Duration presets (hours) the token desk may issue, e.g. {3,4,6,24}.
  // Admins (TOKEN_GENERATE) may use any duration.
  tokenDurationOptions      Int[]       @default([])
  // GST on online pass sales. Bearer CUSTOMER = added on top of the price;
  // MANDAL = price is GST-inclusive (tax carved out of it).
  gstEnabled                Boolean     @default(false)
  gstRateBps                Int         @default(1800)
  gstBearer                 String      @default("CUSTOMER")
  gstSac                    String      @default("9996")
  passInvoiceSeq            Int         @default(0)
  /// Default print layout for passes: A4 | THERMAL_80 | THERMAL_58
  passPrintFormat           String      @default("A4")
  maxVisitorsPerToken       Int         @default(10)
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timeSlots    TimeSlot[]
  tokens       Token[]
  visitors     Visitor[]
  assignments  EventAssignment[]
  applications VolunteerApplication[]
  scanLogs     ScanLog[]
  donations    Donation[]
  expenses     Expense[]
  auditLogs    AuditLog[]
  passOrders   PassOrder[]
  sponsors     Sponsor[]

  @@index([organizationId])
  @@index([state, city])
  @@map("events")
}

// Event-scoped role: a volunteer assigned to Ganesh Utsav 2026 gets nothing on
// Durga Puja 2026 unless separately assigned.
model EventAssignment {
  id         String           @id @default(uuid())
  eventId    String
  userId     String
  roleId     String
  status     MembershipStatus @default(ACTIVE)
  assignedById String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id])

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_assignments")
}

model VolunteerApplication {
  id             String            @id @default(uuid())
  userId         String
  organizationId String
  eventId        String?
  message        String?
  status         ApplicationStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user         User         @relation("ApplicationUser", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([userId])
  @@map("volunteer_applications")
}

// Daily slot template. Issuing a token for (slot, date) copies a concrete
// validFrom/validUntil onto the token — editing a slot later never silently
// changes tokens already in visitors' hands.
model TimeSlot {
  id        String   @id @default(uuid())
  eventId   String
  label     String
  startTime String // "HH:mm" in event timezone
  endTime   String // "HH:mm"; <= startTime means the slot crosses midnight
  capacity  Int?
  // Price per person for public pass booking; 0 = free booking.
  price     Decimal  @default(0) @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tokens     Token[]
  passOrders PassOrder[]

  @@index([eventId])
  @@map("time_slots")
}

model Visitor {
  id        String   @id @default(uuid())
  eventId   String
  name      String?
  mobile    String?
  createdAt DateTime @default(now())

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tokens Token[]

  @@index([eventId])
  @@map("visitors")
}

model Token {
  id                 String      @id @default(uuid())
  eventId            String
  // Human-readable, printed under the QR. Sequential, so NOT a secret.
  tokenCode          String
  // 128-bit random handle carried in the QR together with an HMAC signature.
  // Never derivable from tokenCode; the signature is recomputable, not stored.
  secureToken        String      @unique
  visitorId          String?
  timeSlotId         String?
  visitorCount       Int         @default(1)
  status             TokenStatus @default(ACTIVE)
  validFrom          DateTime
  validUntil         DateTime
  issuedAt           DateTime    @default(now())
  issuedById         String?
  usedAt             DateTime?
  usedById           String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  visitor    Visitor?  @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  timeSlot   TimeSlot? @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  issuedBy   User?     @relation("TokenIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  usedBy     User?     @relation("TokenUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  cancelledBy User?    @relation("TokenCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  scanLogs   ScanLog[]
  // Set when the token was minted by an online pass order / issued for a donation.
  passOrderId String?
  donationId  String?
  donation    Donation? @relation(fields: [donationId], references: [id], onDelete: SetNull)
  /// Partners printed on this pass (snapshot of what was paid for).
  sponsorIds  String[]  @default([])
  passOrder   PassOrder? @relation(fields: [passOrderId], references: [id], onDelete: SetNull)

  @@unique([eventId, tokenCode])
  @@index([passOrderId])
  @@index([eventId, status])
  @@index([eventId, validFrom, validUntil])
  @@index([eventId, timeSlotId])
  @@map("tokens")
}

// Every scan attempt, successful or not. Also the idempotency store: a retried
// request with the same (userId, idempotencyKey) replays the stored result.
// A partial unique index (migration SQL) allows at most ONE non-voided SUCCESS
// per token — the database-level backstop behind the atomic UPDATE.
model ScanLog {
  id             String     @id @default(uuid())
  tokenId        String?
  eventId        String?
  userId         String
  scanTime       DateTime   @default(now())
  result         ScanResult
  failureReason  String?
  method         ScanMethod @default(QR)
  idempotencyKey String?
  // sha256(eventId | scanned payload). A replay is only served when the retry
  // is the same request — a reused key on a different token is refused.
  requestHash    String?
  ipAddress      String?
  userAgent      String?
  // Set only by the audited admin recovery workflow (token reactivation).
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime   @default(now())

  token Token? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([eventId, scanTime])
  @@index([eventId, userId, scanTime])
  @@index([tokenId])
  @@map("scan_logs")
}

model Donation {
  id               String         @id @default(uuid())
  eventId          String
  donorName        String
  donorMobile      String?
  donorEmail       String?
  amount           Decimal        @db.Decimal(12, 2)
  currency         String         @default("INR")
  method           DonationMethod
  paymentStatus    PaymentStatus  @default(PENDING)
  paymentProvider  String         @default("manual")
  paymentReference String?
  providerOrderId  String?
  receiptNo        String?
  /// Random key for the public, shareable receipt link (/r/<id>?k=…).
  shareKey         String?        @unique
  donatedAt        DateTime       @default(now())
  notes            String?
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  passes    Token[]

  @@unique([eventId, receiptNo])
  @@unique([paymentProvider, providerOrderId])
  @@index([eventId, donatedAt])
  @@map("donations")
}

// eventId null = a mandal-wide expense (rent, electricity, annual puja…)
// that belongs to no single festival; it still counts in the annual P&L.
model Expense {
  id             String   @id @default(uuid())
  organizationId String
  eventId        String?
  category    String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @db.Date
  vendor      String?
  receiptRef  String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([eventId, expenseDate])
  @@index([organizationId, expenseDate])
  @@map("expenses")
}

// Administrative audit trail (who/what/when/which event/before/after/reason).
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  eventId        String?
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  reason         String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([eventId, createdAt])
  @@map("audit_logs")
}

// A visitor's public booking. PENDING orders hold slot capacity until
// expiresAt so a slot can't be oversold while people are paying; a paid order
// mints its passes exactly once: one QR per person (perPersonPasses) or one
// group QR admitting visitorCount people.
// The buyer reads the order with its random accessKey — no account needed.
model PassOrder {
  id               String          @id @default(uuid())
  eventId          String
  timeSlotId       String
  validFrom        DateTime
  validUntil       DateTime
  visitorCount     Int
  buyerName        String
  buyerMobile      String
  buyerEmail       String?
  unitPrice        Decimal         @db.Decimal(10, 2)
  /// Taxable value (price × people, ex-GST).
  baseAmount       Decimal         @default(0) @db.Decimal(12, 2)
  gstRateBps       Int             @default(0)
  gstAmount        Decimal         @default(0) @db.Decimal(12, 2)
  gstBearer        String?
  invoiceNo        String?
  /// Total charged to the visitor (base + GST).
  amount           Decimal         @db.Decimal(12, 2)
  currency         String          @default("INR")
  status           PassOrderStatus @default(PENDING)
  paymentProvider  String
  providerOrderId  String?
  paymentReference String?
  accessKey        String          @unique
  perPersonPasses  Boolean         @default(true)
  expiresAt        DateTime
  paidAt           DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  timeSlot TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  tokens   Token[]

  @@unique([paymentProvider, providerOrderId])
  @@unique([eventId, invoiceNo], map: "pass_orders_event_invoice_key")
  @@index([eventId, status])
  @@index([timeSlotId, validFrom, status])
  @@map("pass_orders")
}

// One-time codes sent by email. Only an HMAC of the code is stored; a new code
// supersedes older unconsumed ones; 5 wrong attempts burns it.
model EmailOtp {
  id         String     @id @default(uuid())
  userId     String
  purpose    OtpPurpose
  codeHash   String
  sentTo     String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("email_otps")
}

// Collaboration partners / sponsors (e.g. a jeweller sponsoring the pandal).
// eventId null = shown on every festival of the mandal. The logo is a small
// raster image kept in the row and served by GET /public/sponsors/:id/logo.
model Sponsor {
  id             String      @id @default(uuid())
  organizationId String
  eventId        String?
  name           String
  tier           SponsorTier @default(PARTNER)
  tagline        String?
  bannerText     String?
  websiteUrl     String?
  logo           Bytes?
  logoType       String?
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)
  /// Paid promotion: logo + tagline printed on every pass (fee per pass).
  showOnPasses     Boolean   @default(false)
  passesPrinted    Int       @default(0)
  printFeesPaise   Int       @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@index([eventId])
  @@map("sponsors")
}

// ─── Platform billing: prepaid token credit ─────────────────────────────
// Money is integer paise. Commission is basis points (100 = 1%).
// fee per person admitted = round(tokenPrice × commissionBps / 10000).

model PlatformSettings {
  id                      String   @id @default("default")
  defaultTokenPricePaise  Int      @default(10000)
  defaultCommissionBps    Int      @default(100)
  lowCreditThresholdPaise Int      @default(20000)
  welcomeCreditPaise      Int      @default(10000)
  /// Charged per pass, per partner printed on it (partner promotion).
  sponsorPassFeePaise     Int      @default(50)
  /// Gateway fee deducted from the mandal's share on online payments (bps).
  gatewayFeeBps           Int      @default(0)
  updatedAt               DateTime @updatedAt
  updatedById             String?

  @@map("platform_settings")
}

/// One per mandal. creditBalancePaise has a CHECK (>= 0) — the database
/// itself refuses any debit that would overdraw.
model OrgBilling {
  organizationId          String   @id
  creditBalancePaise      Int      @default(0)
  tokenPricePaise         Int?
  commissionBps           Int?
  lowCreditThresholdPaise Int?
  sponsorPassFeePaise     Int?
  totalTokens             Int      @default(0)
  totalSponsorFeesPaise   Int      @default(0)
  totalPersons            Int      @default(0)
  totalFeesPaise          Int      @default(0)
  totalRechargedPaise     Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_billing")
}

/// Append-only ledger: every change to a mandal's credit (+ recharge / − fee).
model CreditTransaction {
  id                String       @id @default(uuid())
  organizationId    String
  type              CreditTxType
  amountPaise       Int
  balanceAfterPaise Int
  eventId           String?
  source            String?
  tokenCount        Int          @default(0)
  personCount       Int          @default(0)
  unitFeePaise      Int?
  sponsorFeePaise   Int          @default(0)
  sponsorIds        String[]     @default([])
  tokenPricePaise   Int?
  commissionBps     Int?
  reference         String?
  note              String?
  passOrderId       String?
  rechargeId        String?
  createdById       String?
  createdAt         DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([type, createdAt])
  @@index([passOrderId])
  @@map("credit_transactions")
}

model CreditRecharge {
  id              String          @id @default(uuid())
  organizationId  String
  amountPaise     Int
  status          PassOrderStatus @default(PENDING)
  paymentProvider String
  providerOrderId String?
  paymentReference String?
  createdById     String?
  paidAt          DateTime?
  expiresAt       DateTime
  createdAt       DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("credit_recharges")
}

// ─── Split payments: mandal payout account + settlement ledger ─────────
// Sensitive numbers (bank account, PANs) are AES-256-GCM encrypted; only the
// last 4 characters are ever returned by the API.
model PayoutAccount {
  organizationId     String              @id
  entityType         PayoutEntityType
  /// Registered only: TRUST, SOCIETY, SECTION8, PARTNERSHIP, PROPRIETORSHIP, OTHER
  registeredType     String?
  legalName          String
  registrationNumber String?
  orgPanEnc          String?
  orgPanLast4        String?
  gstin              String?
  reg80G             String?
  reg12A             String?
  addressLine        String
  city               String
  state              String
  pincode            String
  contactName        String
  contactRole        String
  contactPhone       String
  contactEmail       String
  signatoryPanEnc    String
  signatoryPanLast4  String
  bankHolderName     String
  bankAccountEnc     String
  bankAccountLast4   String
  ifsc               String
  accountType        String
  proof              Bytes?
  proofType          String?
  status             PayoutAccountStatus @default(PENDING)
  reviewNote         String?
  reviewedById       String?
  reviewedAt         DateTime?
  /// e.g. Razorpay Route linked account id, once registered with the gateway.
  gatewayAccountId   String?
  consentAt          DateTime
  submittedById      String
  submittedAt        DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payout_accounts")
}

/// One row per online payment: who gets what.
model PaymentSettlement {
  id                String           @id @default(uuid())
  organizationId    String
  eventId           String?
  sourceType        String
  sourceId          String           @unique
  grossPaise        Int
  gatewayFeePaise   Int
  commissionPaise   Int
  netPaise          Int
  /// GST inside the gross (part of the mandal's net — the mandal remits it).
  gstPaise          Int              @default(0)
  status            SettlementStatus @default(PENDING_PAYOUT)
  payoutId          String?
  gatewayTransferId String?
  createdAt         DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payout       Payout?      @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@map("payment_settlements")
}

/// Money actually transferred to a mandal (manual UTR now; gateway transfer later).
model Payout {
  id             String   @id @default(uuid())
  organizationId String
  amountPaise    Int
  reference      String
  note           String?
  createdById    String?
  paidAt         DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settlements  PaymentSettlement[]

  @@index([organizationId, paidAt])
  @@map("payouts")
}
