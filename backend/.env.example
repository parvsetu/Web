# Dev database (docker compose up -d → parvsetu-postgres on :55440)
DATABASE_URL=postgresql://parvsetu:parvsetu@localhost:55440/parvsetu?schema=public
# Long random strings. QR_SIGNING_SECRET signs QR payloads — rotating it invalidates every printed QR.
JWT_SECRET=change-me-dev-jwt-secret
JWT_EXPIRES_IN=12h
QR_SIGNING_SECRET=change-me-dev-qr-secret
PORT=4000
CORS_ORIGINS=http://localhost:3000
# Only for local demos of the online-payment flow; never enable in production.
PAYMENTS_MOCK_ENABLED=false
PAYMENTS_MOCK_SECRET=change-me-mock-webhook-secret

# Public pass booking: simulated checkout (no money). Turn off once a real gateway is configured.
BOOKING_DEMO_PAYMENTS=false
# Email. First match wins: MAIL_RELAY_URL, BREVO_API_KEY or RESEND_API_KEY (HTTPS — use one on Render, whose
# free plan blocks SMTP ports, Gmail included), else SMTP_HOST, else emails are written to the server log.
# Relay = the frontend's /api/mail on Vercel, which sends via its own SMTP_* (Gmail app password). Free.
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Parvsetu <no-reply@example.org>"

# Instagram photo import (landing pages) — see docs/INSTAGRAM.md. Real: the Meta app's
# Instagram app ID/secret (Instagram API with Instagram Login, scope instagram_business_basic;
# redirect URI <PUBLIC_WEB_URL>/instagram/callback). Without them the feature is off.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Simulated Instagram with sample photos — dev/tests only, refused in production.
INSTAGRAM_DEMO=false
